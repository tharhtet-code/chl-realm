{
  "rules": {
    "presence": {
      "$worldId": {
        ".read": true,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['x', 'y', 'name', 'sectorId', 'updatedAt'])"
        }
      }
    },
    "chatBubbles": {
      "$worldId": {
        ".read": true,
        "$messageId": {
          ".write": "auth != null"
        }
      }
    }
  }
}
