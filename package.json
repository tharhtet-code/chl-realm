{
  "name": "chl-realm",
  "version": "1.0.0",
  "description": "CHL Realm - 3D Mobile Multiplayer Learning Adventure built on the Antigravity Engine and Firebase",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "deploy": "npm run build && node cli/deploy-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "quest:generate": "tsx cli/gemini-quest-pipeline.ts",
    "xapi:simulate": "tsx cli/xapi-simulator.ts"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "js-yaml": "^5.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
